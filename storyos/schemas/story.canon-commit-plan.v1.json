{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story.canon-commit-plan.v1",
  "title": "StoryOS Canon Commit Plan v1",
  "type": "object",
  "required": ["schema", "filters", "summary", "items", "policy"],
  "properties": {
    "schema": {"const": "story.canon-commit-plan.v1"},
    "filters": {"type": "object"},
    "summary": {
      "type": "object",
      "required": ["claims", "ready", "blocked", "reasons"],
      "properties": {
        "claims": {"type": "integer", "minimum": 0},
        "ready": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "reasons": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "ready", "state", "reasons", "kind", "target_id", "candidate_path", "candidate_sha256", "canonical_path", "canonical_payload", "canonical_payload_sha256", "audit_id", "audit_path", "audit", "materialization"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^clm_[0-9a-f]{32}$"},
          "ready": {"type": "boolean"},
          "state": {"type": "string", "enum": ["ready", "authorized", "blocked", "committed"]},
          "reasons": {"type": "array", "items": {"type": "string"}},
          "kind": {"type": ["string", "null"], "enum": ["event", "fact", null]},
          "target_id": {"type": ["string", "null"]},
          "candidate_path": {"type": ["string", "null"]},
          "candidate_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "canonical_path": {"type": ["string", "null"]},
          "canonical_payload": {},
          "canonical_payload_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "audit_id": {"type": ["string", "null"], "pattern": "^aud_[0-9a-f]{32}$"},
          "audit_path": {"type": ["string", "null"]},
          "audit": {},
          "materialization": {"type": "object"},
          "detail": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "policy": {
      "type": "object",
      "required": ["explicit_candidate_sha256_confirmation", "canonical_create_only", "canonical_overwrite", "audit_precedes_canonical_mutation", "audit_immutable", "current_materialization_revalidated", "one_committed_target_per_claim"],
      "properties": {
        "explicit_candidate_sha256_confirmation": {"const": true},
        "canonical_create_only": {"const": true},
        "canonical_overwrite": {"const": false},
        "audit_precedes_canonical_mutation": {"const": true},
        "audit_immutable": {"const": true},
        "current_materialization_revalidated": {"const": true},
        "one_committed_target_per_claim": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
