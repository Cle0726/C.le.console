{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "C.le.控制台",
  "version": "1.1.2",
  "identifier": "com.local.claude-web-gateway",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @desktop/app",
    "beforeBuildCommand": "npm run build --workspace @desktop/app",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "C.le.控制台",
        "width": 1440,
        "height": 980,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
