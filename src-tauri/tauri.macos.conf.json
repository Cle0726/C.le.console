{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "C.le.控制台",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "resizable": true
      },
      {
        "label": "floating-card",
        "title": "C.le.控制台",
        "create": false,
        "width": 250,
        "height": 290,
        "minWidth": 250,
        "minHeight": 290,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "visible": false
      },
      {
        "label": "status-window",
        "title": "C.le. 状态窗",
        "create": false,
        "width": 480,
        "height": 288,
        "minWidth": 420,
        "minHeight": 270,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "center": true,
        "visible": false
      },
      {
        "label": "web-creator-workspace",
        "title": "C.le. 网页创作工作台",
        "url": "index.html",
        "create": false,
        "width": 1480,
        "height": 920,
        "minWidth": 1050,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#0B0C0E"
      },
      {
        "label": "multi-model-api-console",
        "title": "C.le. 多模型 API 服务",
        "url": "index.html",
        "create": false,
        "width": 1480,
        "height": 920,
        "minWidth": 1050,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "center": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#0B0C0E"
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "../sidecars/cle-cliproxy/bin/cle-cliproxy",
      "../sidecars/jimeng-api/bin/jimeng-api"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
