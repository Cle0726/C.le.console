{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "storyos-manuscript-writer",
  "description": "Narrow manuscript working-copy mutation access for the main window only",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "../sidecars/storyos-manuscript/bin/storyos-manuscript",
          "sidecar": true,
          "args": [
            "save",
            { "validator": "[^\\r\\n\\u0000]+" },
            { "validator": "cle-storyos-manuscript-[0-9a-f]{32}\\.json" }
          ]
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$TEMP/cle-storyos-manuscript-*.json" }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$TEMP/cle-storyos-manuscript-*.json" }
      ]
    }
  ]
}
